{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "^/assets/(.+)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/images/(.+)$",
      "dest": "/images/$1"
    },
    {
      "src": "^/(.+\\.(ico|png|jpg|jpeg|svg|gif|webp|woff|woff2|ttf|otf|eot|css|js|map|json))$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
